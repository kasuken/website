# All keys are optional. Without them the site still builds and runs —
# each integration falls back to placeholder or unauthenticated data.

# Dev.to API key — blog post synchronization
DEVTO_API_KEY=your_devto_api_key_here

# RescueTime API key — productivity tracking
RESCUETIME_API_KEY=your_rescuetime_api_key_here

# GitHub token — raises the API rate limit for repository statistics.
# Read-only public data; a token with no scopes is enough.
GITHUB_TOKEN=your_github_token_here
