---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Button from '../components/Button.astro';
import StatCard from '../components/StatCard.astro';
import SectionHeading from '../components/SectionHeading.astro';

const expertiseAreas = [
	{
		title: 'Web Development',
		description: 'Modern .NET applications, React frontends, and TypeScript development',
		tags: ['.NET', 'React', 'TypeScript', 'Next.js'],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`,
	},
	{
		title: 'Cloud Architecture',
		description: 'Azure solutions, scalable architectures, and serverless applications',
		tags: ['Azure', 'Microservices', 'Serverless', 'Architecture'],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>`,
	},
	{
		title: 'AI Integration',
		description: 'Integrating AI into modern applications, Semantic Kernel, and Prompt Engineering',
		tags: ['OpenAI', 'Semantic Kernel', 'Copilot', 'LLMs'],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z"></path><line x1="9" y1="21" x2="15" y2="21"></line></svg>`,
	},
	{
		title: 'Career Growth',
		description: 'Resume reviews, interview preparation, and developer relations strategies',
		tags: ['DevRel', 'Public Speaking', 'Personal Branding', 'Leadership'],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>`,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Professional Mentoring Services" description="Expert mentoring in web development, cloud technologies, and career growth. Book 1:1 sessions with Microsoft MVP Emanuele Bartolesi." />
	</head>
	<body class="bg-[var(--background)] text-[var(--text-primary)] antialiased min-h-screen flex flex-col selection:bg-[var(--accent)] selection:text-[var(--background)]">
		<Header />
		<main class="flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
			
			<!-- Hero Section -->
			<section class="max-w-3xl mb-16 md:mb-20">
				<p class="mono-label mb-4 reveal reveal-1">1:1 sessions — 20+ years of experience</p>
				<h1 class="font-display text-5xl md:text-7xl tracking-tight text-[var(--text-primary)] mb-6 reveal reveal-2">
					Professional <em class="italic text-[var(--accent)]">mentoring</em>
				</h1>
				<p class="text-xl md:text-2xl text-[var(--text-secondary)] mb-10 leading-relaxed reveal reveal-3">
					Accelerate your career in web development, cloud technologies, and AI/ML with personalized guidance from someone with 20+ years of experience.
				</p>
				<div class="reveal reveal-4">
					<Button href="https://mentors.to/emanuelebartolesi" target="_blank" rel="noopener noreferrer">
						Book a session
						<span aria-hidden="true">→</span>
					</Button>
				</div>
			</section>

			<!-- Statistics -->
			<section class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-24 reveal reveal-5">
				<StatCard value="100+" label="Mentoring Sessions" />
				<StatCard value="55+" label="Happy Mentees" />
				<StatCard value="20+" label="Years Experience" />
				<StatCard value="4.9" label="Average Rating" />
			</section>

			<!-- Areas of Expertise -->
			<section class="mb-24">
				<SectionHeading index="№1" title="Areas of expertise" />
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
					{expertiseAreas.map((area) => (
						<div class="group bg-[var(--background-secondary)] border border-[var(--border)] rounded-[var(--radius-card)] p-8 hover:border-[var(--accent)] hover:-translate-y-[3px] hover:shadow-md transition-all duration-200">
							<div class="w-12 h-12 bg-[var(--accent)]/10 text-[var(--accent)] rounded-[var(--radius-sm)] flex items-center justify-center mb-6" set:html={area.icon} />
							<h3 class="font-display text-2xl text-[var(--text-primary)] mb-3">{area.title}</h3>
							<p class="text-[var(--text-secondary)] mb-6 leading-relaxed">
								{area.description}
							</p>
							<div class="flex flex-wrap gap-2">
								{area.tags.map((tag) => (
									<span class="px-3 py-1 bg-[var(--background)] border border-[var(--border)] mono-label rounded-[var(--radius-sm)]">{tag}</span>
								))}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Expectations -->
			<section class="max-w-3xl mx-auto mb-16">
				<div class="bg-[var(--background-secondary)] border border-[var(--border)] rounded-[var(--radius-card)] p-8 md:p-12">
					<p class="mono-label mb-4">How it works</p>
					<h2 class="font-display text-2xl text-[var(--text-primary)] mb-6">What to expect</h2>
					<ul class="space-y-4 text-[var(--text-secondary)] list-none p-0 m-0">
						<li class="flex items-start gap-3">
							<svg class="w-6 h-6 text-[var(--accent)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span>Personalized advice tailored to your specific goals and context</span>
						</li>
						<li class="flex items-start gap-3">
							<svg class="w-6 h-6 text-[var(--accent)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span>Honest, constructive feedback on your code, architecture, or career trajectory</span>
						</li>
						<li class="flex items-start gap-3">
							<svg class="w-6 h-6 text-[var(--accent)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span>Actionable next steps after every session to keep your momentum</span>
						</li>
						<li class="flex items-start gap-3">
							<svg class="w-6 h-6 text-[var(--accent)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span>Direct insights drawn from 20+ years navigating the tech industry</span>
						</li>
					</ul>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>
