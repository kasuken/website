---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import ProductMark from '../../components/ProductMark.astro';
import ScreenshotLightbox from '../../components/ScreenshotLightbox.astro';
import { products } from '../../data/products.ts';
import { SITE_TITLE } from '../../consts';

// Rendered on request, the same way blog/[slug] is: that route is proven on
// the Amplify host, where extension-less paths go to the server. The sitemap
// learns about these pages from `customPages` in astro.config.mjs.
//
// getStaticPaths is only consulted by the local dev server, which runs in
// static mode and refuses a dynamic route without it. The production build
// is server-rendered and ignores it.
export function getStaticPaths() {
	return products.map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const index = products.findIndex((p) => p.slug === slug?.toLowerCase());
if (index < 0) return new Response(null, { status: 404 });
const product = products[index];

// Posts that name the product. The names are distinctive enough that a
// whole-word match on title, description, or tags does not pull in strangers.
const name = new RegExp(`\\b${product.name}\\b`, 'i');
const related = (await getCollection('blog'))
	.filter((post) => post.id !== 'devto-stats')
	.filter((post) => name.test(`${post.data.title} ${post.data.description} ${(post.data.tags ?? []).join(' ')}`))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const [lead, ...moreShots] = product.screenshots ?? [];
const previous = products[(index - 1 + products.length) % products.length];
const next = products[(index + 1) % products.length];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: product.name,
	description: product.summary,
	applicationCategory: product.slug === 'lapfolio' ? 'HealthApplication' : product.slug === 'daypulse' ? 'LifestyleApplication' : 'BusinessApplication',
	url: product.site ?? product.repo,
	author: { '@type': 'Person', name: 'Emanuele Bartolesi' },
};

const check = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><polyline points="20 6 9 17 4 12"/></svg>`;
const label = 'font-display text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${product.name}: ${product.tagline} · ${SITE_TITLE}`} description={product.summary} image={lead?.src} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-[var(--background)] text-[var(--text-primary)] antialiased">
		<Header />
		<main class="w-full max-w-6xl mx-auto px-6 pt-12 md:pt-16 pb-24" data-product={product.slug}>
			<a href="/products" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-secondary)] no-underline! hover:text-[var(--p-ink)]! transition-colors mb-10">
				<Icon name="arrow-right" class="w-4 h-4 rotate-180" />
				All products
			</a>

			<!-- Header -->
			<header class="flex flex-col sm:flex-row sm:items-center gap-6 pb-10 mb-10 border-b border-[var(--p-edge)]">
				<span class="w-20 h-20 md:w-24 md:h-24 shrink-0 flex items-center justify-center rounded-[var(--radius-card)] bg-[var(--p-tint)] text-[var(--p)] border border-[var(--p-edge)] p-4 md:p-5 reveal reveal-1">
					<ProductMark slug={product.slug} />
				</span>
				<div class="min-w-0 reveal reveal-2">
					<div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3">
						<h1 class="font-display text-5xl md:text-7xl tracking-tight mb-0! text-[var(--text-primary)]">{product.name}</h1>
						<span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--text-secondary)] border border-[var(--border)] rounded-[var(--radius-pill)] px-2.5 py-1">
							<span class={`w-1.5 h-1.5 rounded-full ${product.status === 'Live' ? 'bg-[var(--p)]' : 'border border-current'}`} aria-hidden="true"></span>
							{product.status}
						</span>
					</div>
					<p class="text-xl md:text-2xl text-[var(--p-ink)] font-medium mb-6 max-w-[50ch]">{product.tagline}</p>
					<div class="flex flex-wrap items-center gap-3">
						{product.site && (
							<a href={product.site} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-[var(--radius-pill)] text-sm font-semibold no-underline! bg-[var(--p-solid)] text-[var(--p-on)]! hover:brightness-110 hover:-translate-y-px transition-[filter,transform] duration-200">
								Open {product.name}
								<Icon name="arrow-up-right" class="w-4 h-4" />
							</a>
						)}
						<a href={product.repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-[var(--radius-pill)] text-sm font-semibold no-underline! text-[var(--text-primary)]! border border-[var(--border)] hover:border-[var(--p)] hover:text-[var(--p-ink)]! transition-colors">
							View source on GitHub
							<Icon name="arrow-up-right" class="w-4 h-4" />
						</a>
					</div>
				</div>
			</header>

			<!-- Lead screenshot -->
			{lead && (
				<button
					type="button"
					class="product-shot group block w-full text-left overflow-hidden rounded-[var(--radius-card)] border border-[var(--p-edge)] bg-[var(--background-secondary)] hover:border-[var(--p)] transition-colors cursor-zoom-in mb-16 max-h-[36rem]"
					data-src={lead.src}
					data-alt={lead.alt}
				>
					<img src={lead.src} alt={lead.alt} width={lead.w} height={lead.h} class="w-full h-auto object-cover object-top" />
				</button>
			)}

			<!-- Narrative + capabilities -->
			<section class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 mb-20">
				<div>
					<div class="rounded-[var(--radius-card)] bg-[var(--background-secondary)] border border-[var(--border)] p-6 mb-8">
						<h2 class={`${label} mb-2!`}>The problem</h2>
						<p class="text-[var(--text-primary)] text-xl mb-0! max-w-[56ch]">{product.problem}</p>
					</div>
					<h2 class={`${label} mb-3!`}>What it is</h2>
					<p class="text-[var(--text-secondary)] text-lg leading-relaxed max-w-[68ch] mb-8">{product.summary}</p>
					<h2 class={`${label} mb-3!`}>Reach for it when</h2>
					<p class="text-[var(--text-secondary)] text-lg leading-relaxed max-w-[68ch] mb-8">{product.bestFor}</p>
					<h2 class={`${label} mb-3!`}>Built with</h2>
					<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
						{product.stack.map((tech) => (
							<li class="text-sm font-medium text-[var(--text-secondary)] bg-[var(--background-secondary)] border border-[var(--border)] rounded-[var(--radius-pill)] px-3 py-1.5">{tech}</li>
						))}
					</ul>
				</div>
				<div>
					<h2 class={`${label} mb-5!`}>What it does</h2>
					<ul class="list-none p-0 m-0">
						{product.features.map((feature) => (
							<li class="flex items-start gap-3 py-3 border-b border-[var(--border)] text-[var(--text-secondary)]">
								<span class="mt-1 shrink-0 w-5 h-5 rounded-[var(--radius-pill)] bg-[var(--p-tint)] text-[var(--p-ink)] flex items-center justify-center" set:html={check} aria-hidden="true" />
								<span class="min-w-0">{feature}</span>
							</li>
						))}
					</ul>
				</div>
			</section>

			<!-- More screenshots -->
			{moreShots.length > 0 && (
				<section class="mb-20">
					<h2 class={`${label} mb-5!`}>More screenshots</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5">
						{moreShots.map((shot) => (
							<button
								type="button"
								class="product-shot group block w-full text-left aspect-[16/10] overflow-hidden rounded-[var(--radius-card)] border border-[var(--p-edge)] bg-[var(--background-secondary)] hover:border-[var(--p)] transition-colors cursor-zoom-in"
								data-src={shot.src}
								data-alt={shot.alt}
							>
								<img src={shot.src} alt={shot.alt} width={shot.w} height={shot.h} loading="lazy" class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]" />
							</button>
						))}
					</div>
				</section>
			)}

			<!-- Related writing -->
			{related.length > 0 && (
				<section class="mb-20">
					<h2 class="font-display text-3xl text-[var(--text-primary)] border-b border-[var(--border)] pb-4 mb-2">Writing about {product.name}</h2>
					<ul class="list-none p-0 m-0 divide-y divide-[var(--border)]">
						{related.map((post) => (
							<li>
								<a href={`/blog/${post.id}`} class="group grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-1 sm:gap-6 items-baseline py-5 no-underline!">
									<span class="text-sm text-[var(--text-secondary)] tabular"><FormattedDate date={post.data.pubDate} /></span>
									<span class="font-display text-xl text-[var(--text-primary)] group-hover:text-[var(--p-ink)] transition-colors">{post.data.title}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<!-- Other products -->
			<nav aria-label="Other products" class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-10 border-t border-[var(--border)]">
				{[{ item: previous, hint: 'Previous' }, { item: next, hint: 'Next' }].map(({ item, hint }) => (
					<a
						href={`/products/${item.slug}`}
						data-product={item.slug}
						class="group flex items-center gap-4 rounded-[var(--radius-card)] border border-[var(--border)] p-5 no-underline! hover:border-[var(--p)] hover:bg-[var(--p-tint)] transition-colors"
					>
						<span class="w-12 h-12 shrink-0 p-2.5 rounded-[var(--radius-md)] bg-[var(--p-tint)] text-[var(--p)] border border-[var(--p-edge)]">
							<ProductMark slug={item.slug} />
						</span>
						<span class="min-w-0">
							<span class="block text-sm text-[var(--text-secondary)]">{hint}</span>
							<span class="block font-display text-xl font-semibold text-[var(--text-primary)] group-hover:text-[var(--p-ink)] transition-colors">{item.name}</span>
							<span class="block text-sm text-[var(--text-secondary)] truncate">{item.tagline}</span>
						</span>
					</a>
				))}
			</nav>
		</main>
		<ScreenshotLightbox />
		<Footer />
	</body>
</html>
