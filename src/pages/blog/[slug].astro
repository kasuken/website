---
import { type CollectionEntry, getCollection } from 'astro:content';
import { marked } from 'marked';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

// Dynamic SSR route (no getStaticPaths). This avoids build-time 404s when remote
// content fails to load or changes after deploy. We'll look up the slug at request time.
const { slug } = Astro.params;
const all = await getCollection('blog');
let post: CollectionEntry<'blog'> | undefined = all.find(p => p.id === slug);

if (!post && slug) {
  post = all.find(p => p.id.toLowerCase() === slug.toLowerCase());
}

const notFound = !post;

// Configure marked options
marked.setOptions({
	gfm: true,
	breaks: true,
});

let contentHtml = '';
try {
	if (post?.body) {
		const rendered = marked(post.body);
		contentHtml = typeof rendered === 'string' ? rendered : await rendered;
	}
} catch (err) {
	contentHtml = '<p>Unable to render the content of this post. You can read the original on Dev.to using the link below.</p>';
	console.error('[blog slug] markdown render error for', slug, err);
}
---

<!doctype html>
<html lang="en">
	<head>
		{!notFound && post ? (
			<BaseHead title={post.data.title} description={post.data.description} />
		) : (
			<BaseHead title="Post not found" description="The requested blog post could not be found." />
		)}
	</head>
	<body class="bg-[var(--background)] text-[var(--text-primary)] antialiased selection:bg-[var(--accent)] selection:text-[var(--background)]">
		<Header />
		<main class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
			{notFound || !post ? (
				<section class="max-w-xl mx-auto my-16 text-center bg-[var(--background-secondary)] border border-dashed border-[var(--border)] rounded-[var(--radius-card)] p-12">
					<p class="mono-label mb-4">404 — Dispatch missing</p>
					<h1 class="font-display text-4xl mb-4">Post not found</h1>
					<p class="text-[var(--text-secondary)] mb-8">The blog post you requested does not exist or failed to load during build.</p>
					<a href="/blog" class="btn-secondary">← Back to all posts</a>
				</section>
			) : (
			<>
			<a href="/blog" class="inline-flex items-center gap-2 mono-label no-underline! hover:text-[var(--accent)]! transition-colors mb-10 reveal reveal-1">
				<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
					<path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
				</svg>
				Back to writing
			</a>

			<article>
				<header class="mb-12 reveal reveal-2">
					<div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6 mono-label">
						<time><FormattedDate date={post.data.pubDate} /></time>
						{post.data.readingTimeMinutes && <span>{post.data.readingTimeMinutes} min read</span>}
						{post.data.publicReactionsCount !== undefined && <span>{post.data.publicReactionsCount} reactions</span>}
						{post.data.commentsCount !== undefined && <span>{post.data.commentsCount} comments</span>}
					</div>

					<h1 class="font-display text-4xl md:text-5xl lg:text-6xl tracking-tight leading-[1.05] mb-8">{post.data.title}</h1>

					{post.data.tags && post.data.tags.length > 0 && (
						<div class="flex flex-wrap gap-2">
							{post.data.tags.map((tag: string) => (
								<span class="px-3 py-1 mono-label bg-[var(--background-secondary)] border border-[var(--border)] rounded-[var(--radius-sm)]">#{tag}</span>
							))}
						</div>
					)}
				</header>

				{post.data.heroImage && (
					<img
						src={post.data.heroImage}
						alt=""
						class="w-full max-h-[420px] object-cover rounded-[var(--radius-card)] border border-[var(--border)] mb-12 reveal reveal-3"
					/>
				)}

				<div class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-display prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-[var(--text-primary)] prose-p:text-[var(--text-secondary)] prose-li:text-[var(--text-secondary)] prose-strong:text-[var(--text-primary)] prose-a:text-[var(--accent)] prose-a:decoration-2 prose-a:underline-offset-2 prose-code:font-mono prose-img:rounded-[var(--radius-card)] prose-img:border prose-img:border-[var(--border)] prose-blockquote:border-l-[var(--accent)] prose-blockquote:bg-[var(--background-secondary)] prose-pre:bg-[var(--background-secondary)] prose-pre:border prose-pre:border-[var(--border)] prose-pre:text-[var(--text-primary)] reveal reveal-4">
					<div set:html={contentHtml}></div>
				</div>

				{/* Link to original Dev.to post */}
				<div class="mt-16 p-8 bg-[var(--background-secondary)] border border-[var(--border)] rounded-[var(--radius-card)] text-center">
					<p class="mono-label mb-4">Originally published on Dev.to</p>
					<a href={post.data.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-semibold text-[var(--accent)] no-underline! hover:underline!">
						<svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
							<path d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
							<path d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
						</svg>
						Read the original post
					</a>
				</div>
			</article>
			</>
			)}
		</main>
		<Footer />
	</body>
</html>
