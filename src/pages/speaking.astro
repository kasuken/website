---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Types for Sessionize API response
interface SessionizeSpeaker {
  firstName: string;
  lastName: string;
  tagline: string;
  bio: string;
  speakerProfileUrl: string;
  photoUrl: string;
  photoLargeUrl: string;
}

interface SessionizeSession {
  id: number;
  title: string;
  description: string;
  sessionUrl: string;
  languageCode: string;
  language: string;
}

interface SessionizeEvent {
  id: number;
  name: string;
  eventStartDate: string; // ISO
  eventEndDate: string;   // ISO
  location: string;
  website: string | null;
  slug: string;
}

interface SessionizeApiResponse {
  speaker: SessionizeSpeaker;
  sessions: SessionizeSession[];
  events: SessionizeEvent[];
}

const endpoint = 'https://sessionize.com/api/speaker/json/h69iuxpcmg';

let data: SessionizeApiResponse | null = null;
let fetchError: string | null = null;

try {
  const res = await fetch(endpoint, {
    headers: {
      'User-Agent': 'Mozilla/5.0 (compatible; SiteBuildBot/1.0; +https://example.com)'
    }
  });
  if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText}`);
  data = await res.json();
} catch (err) {
  fetchError = err instanceof Error ? err.message : 'Unknown error';
}

// Helpers
const toDate = (s: string) => new Date(s);

const now = new Date();
const _events = data?.events || [];
const upcomingEvents = _events.filter(e => toDate(e.eventEndDate) >= now)
  .sort((a, b) => toDate(a.eventStartDate).getTime() - toDate(b.eventStartDate).getTime());
const pastEvents = _events.filter(e => toDate(e.eventEndDate) < now)
  .sort((a, b) => toDate(b.eventStartDate).getTime() - toDate(a.eventStartDate).getTime()); // descending

// Extract simple technology tags from titles/descriptions
const techKeywords = ['Azure', 'GitHub', 'DevOps', 'CI/CD', 'Docker', 'Kubernetes', 'C#', '.NET', 'React', 'Node.js', 'AI', 'Cloud', 'Microservices', 'Blazor', 'ASP.NET', 'TypeScript', 'JavaScript'];
const techSet = new Set<string>();

const sessionsByLanguage: Record<string, SessionizeSession[]> = {};

data?.sessions?.forEach(s => {
  techKeywords.forEach(k => {
    if (s.title.toLowerCase().includes(k.toLowerCase()) || 
        (s.description && s.description.toLowerCase().includes(k.toLowerCase()))) {
      techSet.add(k);
    }
  });

  if (!sessionsByLanguage[s.language]) {
    sessionsByLanguage[s.language] = [];
  }
  sessionsByLanguage[s.language].push(s);
});

const technologies = Array.from(techSet).sort((a, b) => a.localeCompare(b));

const fmtDate = (iso: string) => {
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Speaking - My Tech Talks and Events" description="Speaking engagements, conference talks, and technical sessions by Emanuele Bartolesi on Azure, GitHub, DevOps, and .NET." />
	</head>
	<body class="bg-[var(--background)] text-[var(--text-primary)] antialiased min-h-screen flex flex-col">
		<Header />
		<main class="flex-grow w-full max-w-6xl mx-auto px-6 py-16 md:py-24">

			<!-- Hero -->
			<section class="max-w-3xl mb-16 md:mb-20">
				<h1 class="font-display text-5xl md:text-7xl tracking-tight text-[var(--text-primary)] mb-6">
					Tech <em class="italic text-[var(--accent-text)]">speaking</em>
				</h1>
				<p class="text-xl md:text-2xl text-[var(--text-secondary)] leading-relaxed max-w-[58ch] mb-10">
					I speak at conferences, meetups, and online events about Azure,
					Microsoft 365, DevOps, CI/CD, GitHub, and .NET. Here is where I have
					been, and where I am headed next.
				</p>

				<div class="rounded-[var(--radius-card)] bg-[var(--background-secondary)] border border-[var(--border)] p-8">
					<h2 class="font-display text-2xl text-[var(--text-primary)] mb-3">
						Want me to speak at your event?
					</h2>
					<p class="text-[var(--text-secondary)] max-w-[56ch] mb-6">
						Reach out via my social channels or LinkedIn — or browse the full
						catalogue of talks on my Sessionize profile.
					</p>
					<a
						href="https://sessionize.com/emanuelebartolesi/"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-6 py-3 rounded-[var(--radius-pill)] text-sm font-semibold no-underline! bg-[var(--accent)] text-[var(--on-accent)]! hover:brightness-110 hover:-translate-y-px transition-[filter,transform] duration-200"
					>
						View speaker profile
						<Icon name="arrow-up-right" class="w-4 h-4" />
					</a>
				</div>
			</section>

			{fetchError ? (
				<div class="rounded-[var(--radius-card)] bg-[var(--background-secondary)] border border-dashed border-[var(--border)] p-12 text-center max-w-2xl mx-auto">
					<h2 class="font-display text-2xl text-[var(--text-primary)] mb-3">Unable to load speaking data</h2>
					<p class="text-[var(--text-secondary)] mb-6 max-w-[50ch] mx-auto">The Sessionize feed could not be reached right now. Please try again later, or browse my full speaker profile.</p>
					<a href="https://sessionize.com/emanuelebartolesi/" target="_blank" rel="noopener noreferrer" class="btn-secondary">
						View Sessionize profile
						<Icon name="arrow-up-right" class="w-4 h-4" />
					</a>
				</div>
			) : !data ? (
				<div class="rounded-[var(--radius-card)] bg-[var(--background-secondary)] border border-[var(--border)] p-12 text-center max-w-2xl mx-auto">
					<h2 class="font-display text-2xl text-[var(--text-primary)] mb-2">Fetching events…</h2>
					<p class="text-[var(--text-secondary)] mb-0">Getting the latest information from Sessionize.</p>
				</div>
			) : (
				<div class="space-y-20 md:space-y-28">

					{/* Upcoming events */}
					<section aria-labelledby="upcoming-heading">
						<div class="flex items-center gap-4 mb-10 border-b border-[var(--border)] pb-5">
							<span class="w-11 h-11 shrink-0 flex items-center justify-center rounded-[var(--radius-md)] bg-[var(--accent)]/10 text-[var(--accent-text)]">
								<Icon name="calendar" class="w-5 h-5" />
							</span>
							<div>
								<h2 id="upcoming-heading" class="font-display text-3xl text-[var(--text-primary)] mb-0!">Upcoming events</h2>
								<p class="text-[var(--text-secondary)] mb-0!">Where you can catch me next</p>
							</div>
						</div>

						{upcomingEvents.length === 0 ? (
							<div class="rounded-[var(--radius-card)] border border-dashed border-[var(--border)] p-12 text-center">
								<Icon name="calendar" class="w-8 h-8 mx-auto mb-3 text-[var(--text-light)]" />
								<p class="text-[var(--text-secondary)] mb-0">No upcoming events listed right now.</p>
							</div>
						) : (
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								{upcomingEvents.map(e => (
									<article class="group relative flex flex-col rounded-[var(--radius-card)] bg-[var(--background-secondary)] border border-[var(--border)] p-6 hover:border-[var(--accent)] hover:-translate-y-[3px] hover:shadow-md transition-all duration-200">
										<div class="flex items-start justify-between gap-4 mb-4">
											<span class="w-11 h-11 shrink-0 flex items-center justify-center rounded-[var(--radius-md)] bg-[var(--accent)]/10 text-[var(--accent-text)]">
												<Icon name="mic" class="w-5 h-5" />
											</span>
											<span class="inline-flex items-center px-3 py-1 rounded-[var(--radius-pill)] bg-[var(--accent)] text-[var(--on-accent)] text-xs font-semibold">
												Upcoming
											</span>
										</div>

										<h3 class="font-display text-xl leading-snug text-[var(--text-primary)] mb-4 group-hover:text-[var(--accent-text)] transition-colors">
											{e.name}
										</h3>

										<div class="space-y-2.5 mb-6 text-sm text-[var(--text-secondary)] flex-grow">
											<div class="flex items-center gap-2.5">
												<Icon name="calendar" class="w-4 h-4 text-[var(--text-light)]" />
												<span class="tabular">{fmtDate(e.eventStartDate)} – {fmtDate(e.eventEndDate)}</span>
											</div>
											{e.location && (
												<div class="flex items-center gap-2.5">
													<Icon name="map-pin" class="w-4 h-4 text-[var(--text-light)]" />
													<span>{e.location}</span>
												</div>
											)}
										</div>

										{e.website && (
											<a href={e.website} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-[var(--radius-pill)] text-sm font-semibold no-underline! text-[var(--text-primary)]! border border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent-text)]! transition-colors">
												Visit website
												<Icon name="arrow-up-right" class="w-4 h-4" />
											</a>
										)}
									</article>
								))}
							</div>
						)}
					</section>

					{/* Past events */}
					<section aria-labelledby="past-heading">
						<div class="flex items-center gap-4 mb-10 border-b border-[var(--border)] pb-5">
							<span class="w-11 h-11 shrink-0 flex items-center justify-center rounded-[var(--radius-md)] bg-[var(--background-tertiary)] text-[var(--text-secondary)]">
								<Icon name="archive" class="w-5 h-5" />
							</span>
							<div>
								<h2 id="past-heading" class="font-display text-3xl text-[var(--text-primary)] mb-0!">Past events</h2>
								<p class="text-[var(--text-secondary)] mb-0!">A selection of previous conferences and meetups</p>
							</div>
						</div>

						{pastEvents.length === 0 ? (
							<div class="rounded-[var(--radius-card)] border border-dashed border-[var(--border)] p-8 text-center">
								<p class="text-[var(--text-secondary)] mb-0">No past events listed.</p>
							</div>
						) : (
							<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
								{pastEvents.slice(0, 12).map(e => (
									<article class="group flex flex-col rounded-[var(--radius-card)] border border-[var(--border)] p-5 hover:border-[var(--text-secondary)] transition-colors">
										<h3 class="font-display text-lg leading-snug text-[var(--text-primary)] mb-3 line-clamp-2">
											{e.name}
										</h3>

										<div class="space-y-2 mb-4 text-sm text-[var(--text-secondary)] flex-grow">
											<div class="flex items-center gap-2.5">
												<Icon name="calendar" class="w-3.5 h-3.5 text-[var(--text-light)]" />
												<span class="tabular">{fmtDate(e.eventStartDate)}</span>
											</div>
											{e.location && (
												<div class="flex items-center gap-2.5 min-w-0">
													<Icon name="map-pin" class="w-3.5 h-3.5 text-[var(--text-light)]" />
													<span class="truncate">{e.location}</span>
												</div>
											)}
										</div>

										{e.website && (
											<a href={e.website} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-text)] transition-colors">
												Website
												<Icon name="arrow-up-right" class="w-3.5 h-3.5" />
											</a>
										)}
									</article>
								))}
							</div>
						)}
					</section>

					{/* Technologies and topics */}
					{technologies.length > 0 && (
						<section aria-labelledby="tech-heading">
							<div class="flex items-center gap-4 mb-10 border-b border-[var(--border)] pb-5">
								<span class="w-11 h-11 shrink-0 flex items-center justify-center rounded-[var(--radius-md)] bg-[var(--background-tertiary)] text-[var(--text-secondary)]">
									<Icon name="tag" class="w-5 h-5" />
								</span>
								<div>
									<h2 id="tech-heading" class="font-display text-3xl text-[var(--text-primary)] mb-0!">Technologies &amp; topics</h2>
									<p class="text-[var(--text-secondary)] mb-0!">Keywords extracted from session titles and descriptions</p>
								</div>
							</div>
							<ul class="flex flex-wrap gap-2.5 list-none p-0 m-0">
								{technologies.map(t => (
									<li class="px-4 py-2 rounded-[var(--radius-pill)] bg-[var(--background-secondary)] border border-[var(--border)] text-[var(--text-primary)] text-sm font-medium">
										{t}
									</li>
								))}
							</ul>
						</section>
					)}

					{/* Available sessions */}
					{data.sessions && data.sessions.length > 0 && (
						<section aria-labelledby="sessions-heading">
							<div class="flex items-center gap-4 mb-10 border-b border-[var(--border)] pb-5">
								<span class="w-11 h-11 shrink-0 flex items-center justify-center rounded-[var(--radius-md)] bg-[var(--accent)]/10 text-[var(--accent-text)]">
									<Icon name="slides" class="w-5 h-5" />
								</span>
								<div>
									<h2 id="sessions-heading" class="font-display text-3xl text-[var(--text-primary)] mb-0!">Available sessions</h2>
									<p class="text-[var(--text-secondary)] mb-0!">Talks ready for conferences, meetups, and corporate events</p>
								</div>
							</div>
							<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
								{data.sessions.map(s => (
									<article class="group flex flex-col rounded-[var(--radius-card)] bg-[var(--background-secondary)] border border-[var(--border)] p-6 hover:border-[var(--accent)] hover:-translate-y-[3px] hover:shadow-md transition-all duration-200">
										<div class="flex items-start justify-between gap-4 mb-4">
											<h3 class="font-display text-xl leading-snug text-[var(--text-primary)] mb-0! group-hover:text-[var(--accent-text)] transition-colors">
												{s.title}
											</h3>
											<span class="inline-flex items-center gap-1.5 shrink-0 px-2.5 py-1 rounded-[var(--radius-pill)] border border-[var(--border)] text-xs font-medium text-[var(--text-secondary)]">
												<Icon name="globe" class="w-3.5 h-3.5" />
												{s.language}
											</span>
										</div>

										{s.description && (
											<p class="text-sm text-[var(--text-secondary)] mb-6 line-clamp-4 leading-relaxed flex-grow">
												{s.description}
											</p>
										)}

										<div class="mt-auto pt-4 border-t border-[var(--border)]">
											<a href={s.sessionUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-primary)] hover:text-[var(--accent-text)] transition-colors">
												View session details
												<Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
											</a>
										</div>
									</article>
								))}
							</div>
						</section>
					)}
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
