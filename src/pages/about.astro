---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatCard from '../components/StatCard.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About Me - Emanuele Bartolesi" description="GitHub Technical Lead and Entrepreneur with over 20 years of experience in IT. Microsoft MVP, GitHub Star, and passionate about cloud technologies and AI." />
	</head>
	<body class="bg-[var(--background)] text-[var(--text-primary)] antialiased min-h-screen flex flex-col selection:bg-[var(--accent)] selection:text-[var(--background)]">
		<Header />
		
		<main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
			<!-- Hero Section — asymmetric editorial -->
			<section class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end mb-20">
				<div class="md:col-span-8">
					<p class="mono-label mb-4 reveal reveal-1">Zurich, Switzerland — since 2003 in tech</p>
					<h1 class="font-display text-5xl md:text-7xl tracking-tight text-[var(--text-primary)] mb-6 reveal reveal-2">About me</h1>
					<p class="text-xl md:text-2xl text-[var(--text-secondary)] max-w-2xl mb-0 reveal reveal-3">
						GitHub Technical Lead, entrepreneur, and passionate technologist building the future of software.
					</p>
				</div>
				<div class="md:col-span-4 reveal reveal-3">
					<div class="relative w-44 h-44 md:w-full md:h-auto md:aspect-square md:rotate-2">
						<img src="/img/2757486.png" alt="Portrait of Emanuele Bartolesi" class="w-full h-full object-cover rounded-[var(--radius-card)] border border-[var(--border)] shadow-lg" />
						<span class="hidden md:block absolute -left-3 -bottom-3 w-full h-full border border-[var(--accent)] rounded-[var(--radius-card)] -z-10" aria-hidden="true"></span>
					</div>
				</div>
			</section>

			<!-- Content Grid -->
			<div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16">
				<!-- Left Column: Intro -->
				<div class="md:col-span-8 space-y-8 prose prose-lg dark:prose-invert prose-headings:font-display prose-p:text-[var(--text-secondary)] prose-strong:text-[var(--text-primary)] prose-a:text-[var(--accent)]">
					<p class="text-xl leading-relaxed">
						Hi, I'm <strong class="text-[var(--accent)]!">Emanuele Bartolesi</strong>. With over 20 years of experience in the IT industry, I've worn many hats: developer, consultant, trainer, and speaker.
					</p>
					<p>
						My passion lies at the intersection of frontend technologies and cloud scale—specifically Microsoft Azure and AI. Throughout my career, I've designed and implemented robust solutions across diverse domains including e-commerce, banking, insurance, and healthcare.
					</p>
					<p>
						Currently based in Zurich, I am deeply involved in local and international tech communities. Whether I'm presenting at major conferences or live coding on Twitch, my goal is always the same: sharing knowledge. You can find many of my thoughts published on <a href="https://dev.to/kasuken" target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] underline decoration-2 underline-offset-2">dev.to/kasuken</a>.
					</p>
					
					<hr class="border-[var(--border)] my-12" />
					
					<h2 class="font-display">Professional achievements</h2>
					<p>
						I'm incredibly honored to have been recognized as a <strong>Microsoft MVP for 12 times</strong>, a <strong>4-time GitHub Star</strong>, and the <strong>GitHub Star of the Year in 2023</strong>.
					</p>
					<p>
						Beyond coding, I am a technical author and instructor. I've written a book on Minimal APIs in ASP.NET Core and authored a course on "Learning GitHub" for LinkedIn Learning. Mentoring others is one of my greatest joys in this industry.
					</p>
				</div>
				
				<!-- Right Column: Stats / Quick Facts -->
				<div class="md:col-span-4 space-y-4">
					<StatCard value="12×" label="Microsoft MVP" />
					<StatCard value="4×" label="GitHub Star" />
					<StatCard value="2023" label="GitHub Star of the Year" />
					<StatCard value="2+" label="Books & Courses" />
				</div>
			</div>
			
			<div class="mt-20 p-10 md:p-14 bg-[var(--text-primary)] text-[var(--background)] rounded-[var(--radius-card)] text-center">
				<p class="mono-label text-[var(--background)]/60! mb-4">Open for conversation</p>
				<h3 class="font-display text-3xl text-[var(--background)] mb-4">Want to connect?</h3>
				<p class="text-[var(--background)]/80 mb-8 max-w-xl mx-auto">I'm always open to discussing new projects, creative ideas or opportunities to be part of your visions.</p>
				<a href="https://linkedin.com/in/bartolesiemanuele" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold bg-[var(--accent)] text-[var(--background)]! rounded-[var(--radius-pill)] no-underline! hover:bg-[var(--accent-dark)] hover:-translate-y-[3px] transition-all duration-200">
					Reach out on LinkedIn
				</a>
			</div>
		</main>

		<Footer />
	</body>
</html>
