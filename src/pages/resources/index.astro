---
import ResourceLayout from '../../layouts/ResourceLayout.astro';
import Icon from '../../components/Icon.astro';
import { copilotReviewDate, copilotReviewLabel } from '../../data/copilot';
import { claudeReviewDate, claudeReviewLabel } from '../../data/claude';
import { antigravityReviewDate, antigravityReviewLabel } from '../../data/antigravity';
import { codexReviewDate, codexReviewLabel } from '../../data/codex';
---

<ResourceLayout title="Resources" description="Practical reference tables for Codex, GitHub Copilot, Claude, and Google Antigravity. Compare models, credit and API prices, and plans with dated official sources.">
  <header class="resource-intro">
    <h1>Resources</h1>
    <p class="resource-lead">Reference material to keep close while you work.</p>
    <p class="resource-summary">Quick comparisons, practical guidance, and links to the documentation behind them.</p>
  </header>

  <section class="resource-catalog" aria-labelledby="guides-heading">
    <h2 id="guides-heading">Reference guides</h2>
    <article class="resource-entry">
      <div>
        <h3><a href="/resources/github-copilot">GitHub Copilot guide <Icon name="arrow-right" class="resource-arrow" /></a></h3>
        <p>Compare model costs, task choices, Auto and HydraFusion, and personal versus organization plans.</p>
        <nav class="resource-entry-links" aria-label="GitHub Copilot guide sections">
          <a href="/resources/github-copilot#model-pricing">Model pricing</a>
          <a href="/resources/github-copilot#choosing-a-model">Choosing a model</a>
          <a href="/resources/github-copilot#auto-hydrafusion">Auto &amp; HydraFusion</a>
          <a href="/resources/github-copilot#plans">Plan comparison</a>
        </nav>
      </div>
      <p class="resource-reviewed">Reviewed <time datetime={copilotReviewDate}>{copilotReviewLabel}</time></p>
    </article>
    <article class="resource-entry">
      <div>
        <h3><a href="/resources/claude">Claude guide <Icon name="arrow-right" class="resource-arrow" /></a></h3>
        <p>Compare Anthropic's model prices, caching, Batch and Fast modes, task choices, and Claude personal and business plans.</p>
        <nav class="resource-entry-links" aria-label="Claude guide sections">
          <a href="/resources/claude#model-pricing">API model pricing</a>
          <a href="/resources/claude#choosing-a-model">Choosing a model</a>
          <a href="/resources/claude#plans">Plan comparison</a>
        </nav>
      </div>
      <p class="resource-reviewed">Reviewed <time datetime={claudeReviewDate}>{claudeReviewLabel}</time></p>
    </article>
    <article class="resource-entry">
      <div>
        <h3><a href="/resources/antigravity">Antigravity guide <Icon name="arrow-right" class="resource-arrow" /></a></h3>
        <p>Check model access and plan quotas, then compare Gemini 4 Argon's API prices, thinking levels, and token limits.</p>
        <nav class="resource-entry-links" aria-label="Antigravity guide sections">
          <a href="/resources/antigravity#models">Model access</a>
          <a href="/resources/antigravity#gemini-4-argon">Gemini 4 Argon</a>
          <a href="/resources/antigravity#plans">Plan comparison</a>
        </nav>
      </div>
      <p class="resource-reviewed">Reviewed <time datetime={antigravityReviewDate}>{antigravityReviewLabel}</time></p>
    </article>
    <article class="resource-entry">
      <div>
        <h3><a href="/resources/codex">Codex guide <Icon name="arrow-right" class="resource-arrow" /></a></h3>
        <p>Choose models and reasoning levels, compare plans and credit rates, and understand separate API pricing and local or cloud workflows.</p>
        <nav class="resource-entry-links" aria-label="Codex guide sections">
          <a href="/resources/codex#model-pricing">Credit rates</a>
          <a href="/resources/codex#choosing-a-model">Reasoning &amp; speed</a>
          <a href="/resources/codex#plans">Plan comparison</a>
          <a href="/resources/codex#api-pricing">API pricing</a>
        </nav>
      </div>
      <p class="resource-reviewed">Reviewed <time datetime={codexReviewDate}>{codexReviewLabel}</time></p>
    </article>
  </section>
</ResourceLayout>
