---
import ResourceLayout from '../../layouts/ResourceLayout.astro';
import CopilotPricingTable from '../../components/CopilotPricingTable.astro';
import {
  copilotDescription, copilotReviewDate, copilotReviewLabel, copilotSources,
  copilotPlans, modelGroups, taskGuidance,
  copilotSelectionOptions, copilotFusionEfforts, copilotFusionPatterns, copilotBillingRules,
  copilotAccessPlans, copilotUniverseUpdates,
} from '../../data/copilot';

const number = (value: number) => value.toLocaleString('en-US');
const planRows = [
  { label: 'Monthly price (USD)', values: copilotPlans.map(p => `$${p.monthly}${p.audience === 'Organization' ? ' / seat' : ''}`), numeric: true },
  { label: 'Base AI credits / month', values: copilotPlans.map(p => number(p.base)), numeric: true },
  { label: 'Flex credits / month', values: copilotPlans.map(p => p.flex === null ? 'Not applicable' : number(p.flex)), numeric: true },
  { label: 'Total included AI credits', values: copilotPlans.map(p => number(p.base + (p.flex ?? 0))), numeric: true, highlight: true },
  { label: 'Who the credits belong to', values: copilotPlans.map(p => p.ownership) },
  { label: 'Model access', values: copilotPlans.map(p => p.models) },
  { label: 'Management', values: copilotPlans.map(p => p.management) },
  { label: 'After included credits run out', values: copilotPlans.map(p => p.extra) },
  { label: 'GitHub training on interaction data', values: copilotPlans.map(p => p.training) },
];
---

<ResourceLayout title="GitHub Copilot guide" description={copilotDescription} guide>
  <header class="resource-intro guide-intro">
    <h1>GitHub Copilot <span>guide</span></h1>
    <p class="resource-lead">Model costs, task choices, and plans. All in tables you can search and compare.</p>
    <p class="resource-reviewed">Reviewed against GitHub's documentation on <time datetime={copilotReviewDate}>{copilotReviewLabel}</time>. Prices are in USD.</p>
    <nav class="resource-contents" aria-label="On this page">
      <a href="#model-pricing">Model pricing</a>
      <a href="#choosing-a-model">Choosing a model</a>
      <a href="#copilot-fusion">Auto &amp; Copilot Fusion</a>
      <a href="#plans">Plan comparison</a>
      <a href="#universe-updates">Universe updates</a>
      <a href="#sources">Sources &amp; updates</a>
    </nav>
  </header>

  <section class="resource-section" id="model-pricing" aria-labelledby="pricing-heading">
    <div class="resource-section-heading">
      <h2 id="pricing-heading">What does each model cost?</h2>
      <a href={copilotSources.pricing.url}>GitHub pricing documentation</a>
    </div>
    <p class="resource-summary">Compare the token rates behind Copilot's AI credits. <strong>1 AI credit = $0.01 USD.</strong> A task can make several model calls, so its cost depends on the tokens used across the whole session.</p>
    <p class="resource-note">These are Copilot usage rates. Default and long-context tiers are separate; select a tier to see the corresponding input threshold. Paid code completions and next edit suggestions do not consume AI credits.</p>
    <CopilotPricingTable />
    <p class="resource-source">Rates: <a href={copilotSources.pricing.url}>GitHub's pricing tables</a>. Eligibility: <a href={copilotSources.models.url}>supported models and plan restrictions</a>. No separate long-context price is inferred where GitHub does not publish one.</p>
    <p class="resource-note copilot-after-table"><a href="#copilot-fusion">Auto and Fusion billing</a>: Auto retains a 10% paid-plan discount on supported surfaces. Fusion has a separate, temporary 30% paid-plan discount through 30 November 2026.</p>
    <p class="resource-source">Model update: entries retired on 19 October 2026 have been removed. See <a href={copilotSources.retirements.url}>GitHub's deprecation notice</a>.</p>
    <p class="resource-note">Plan ahead: GitHub schedules Claude Opus 4.8, Claude Opus 5, and GPT-5.6 Terra for retirement on <strong>16 November 2026</strong>. Opus 4.8 remains available to individual annual subscribers. These models are still listed at this review date; see <a href={copilotSources.upcomingRetirements.url}>the notice and suggested alternatives</a>.</p>
    <p class="resource-note">This table covers coding/chat model token rates. Image-generation tools have separate image-token charges. Copilot code review also consumes GitHub Actions minutes alongside AI credits; check <a href={copilotSources.pricing.url}>GitHub's current billing details</a>.</p>
  </section>

  <section class="resource-section" id="choosing-a-model" aria-labelledby="choice-heading">
    <div class="resource-section-heading">
      <h2 id="choice-heading">Choose for the task</h2>
      <a href={copilotSources.comparison.url}>GitHub model guidance</a>
    </div>
    <p class="resource-summary">Start with the least expensive model that handles your task reliably, then move up when the work needs more reasoning or autonomy. The matrix below is editorial guidance, not a benchmark or an official GitHub ranking.</p>
    <p class="resource-summary"><strong>Not sure which model to choose?</strong> Select <a href={copilotSources.fusion.url}>Copilot Fusion</a> where available and start with Standard. Where the picker still offers <a href={copilotSources.auto.url}>Auto</a>, it can choose a model for you. Fusion combines the former Auto and HydraFusion experiences; availability and effort levels depend on your plan, client, and policies.</p>
    <dl class="model-groups">
      {modelGroups.map(group => <div><dt>{group.name}</dt><dd>{group.examples}</dd></div>)}
    </dl>
    <div class="resource-table-scroll" role="region" aria-labelledby="task-caption" tabindex="0">
      <table class="resource-table task-table">
        <caption id="task-caption">Suggested starting points by task; “Not first choice” can mean too limited or unnecessarily costly.</caption>
        <thead><tr><th scope="col">Your task</th>{modelGroups.map(group => <th scope="col">{group.name}</th>)}</tr></thead>
        <tbody>
          {taskGuidance.map(row => <tr><th scope="row">{row.task}</th>{row.fits.map(fit => <td class:list={{ 'recommended-fit': fit === 'Start here', 'secondary-fit': fit !== 'Start here' }}>{fit}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
    <p class="resource-note">These groups describe the work, not a hard boundary between models. Fable models have a <a href="#fable-data">data-retention exception</a>. Check availability and review the result, including tests and security-sensitive changes.</p>
  </section>

  <section class="resource-section" id="copilot-fusion" aria-labelledby="routing-heading">
    <span id="auto-hydrafusion"></span>
    <div class="resource-section-heading"><h2 id="routing-heading">Auto &amp; Copilot Fusion</h2><a href={copilotSources.fusion.url}>GitHub Fusion documentation</a></div>
    <p class="resource-summary">Copilot Fusion became generally available at Universe on 28 October 2026. It combines Auto routing with Project HydraFusion's orchestration. Existing Auto, HydraFusion, and HydraFusion Max selections transition to the corresponding Fusion efforts on supported clients.</p>
    <p class="resource-table-hint" id="selection-hint">Scroll to compare options. Task suggestions are editorial guidance.</p>
    <div class="resource-table-scroll" role="region" aria-labelledby="selection-caption" aria-describedby="selection-hint" tabindex="0">
      <table class="resource-table copilot-routing-table"><caption id="selection-caption">Manual selection, Fusion, and remaining Auto surfaces</caption>
        <thead><tr><th scope="col">Option</th><th scope="col">What it does</th><th scope="col">Suggested use</th></tr></thead>
        <tbody>{copilotSelectionOptions.map(option => <tr><th scope="row">{option.name}</th><td>{option.behavior}</td><td>{option.use}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="resource-source">Sources: <a href={copilotSources.fusionRelease.url}>launch and migration</a>, <a href={copilotSources.auto.url}>remaining Auto surfaces</a>.</p>
    <span id="auto-mode"></span><h3 class="copilot-subheading" id="fusion-effort">Choose a Fusion effort</h3>
    <p class="resource-summary">Fusion is available in VS Code, Copilot CLI, the Copilot app, and JetBrains IDEs. Effort availability follows your plan and allowed model pool. Fusion Max is an effort level, separate from the Copilot Max subscription.</p>
    <p class="resource-table-hint" id="auto-tier-hint">Scroll to compare effort levels, including the non-selectable Fast option.</p>
    <div class="resource-table-scroll" role="region" aria-labelledby="auto-tier-caption" aria-describedby="auto-tier-hint" tabindex="0">
      <table class="resource-table copilot-auto-table"><caption id="auto-tier-caption">Current Fusion effort levels</caption>
        <thead><tr><th scope="col">Effort</th><th scope="col">Priority</th><th scope="col">Starting point</th></tr></thead>
        <tbody>{copilotFusionEfforts.map(tier => <tr><th scope="row">{tier.name}</th><td>{tier.priority}</td><td>{tier.use}</td></tr>)}</tbody>
      </table>
    </div>
    <div class="pricing-notes">
      <p><strong>Fusion billing.</strong> Participating cloud models use their published token rates; there is no separate orchestration fee. Paid plans receive a {copilotBillingRules.fusionDiscount * 100}% model-cost discount through <time datetime={copilotBillingRules.fusionDiscountUntil}>30 November 2026</time>. Extra passes can still increase total usage. No post-promotion discount is assumed.</p>
      <p><strong>Auto remains on other surfaces.</strong> GitHub lists cloud, GitHub Mobile, Eclipse, Xcode, and Visual Studio experiences. Its 10% paid-plan discount applies to supported Copilot Chat and cloud-agent usage. The old Efficiency/Balance/Intelligence tier description is superseded by Fusion effort controls on migrated clients.</p>
      <p><strong>Local routing is a separate public preview.</strong> Fusion Standard can route to supported installed local models. Windows hardware requirements apply to MAI Code; Qwen3.8 Flash Next routing in CLI supports Windows, macOS, and Linux. Follow GitHub's setup instructions and experimental settings.</p>
    </div>
    <p class="resource-source">Sources: <a href={copilotSources.fusion.url}>Fusion effort, local routing, and billing</a>; <a href={copilotSources.auto.url}>Auto availability and discount</a>.</p>
    <span id="hydrafusion"></span><h3 class="copilot-subheading" id="fusion-patterns">Fusion execution patterns</h3>
    <p class="resource-table-hint" id="hydra-pattern-hint">Scroll to read each pattern. Fusion chooses the pattern for the prompt.</p>
    <div class="resource-table-scroll" role="region" aria-labelledby="hydra-pattern-caption" aria-describedby="hydra-pattern-hint" tabindex="0">
      <table class="resource-table copilot-pattern-table"><caption id="hydra-pattern-caption">Single, Cascade, and Critique</caption>
        <thead><tr><th scope="col">Pattern</th><th scope="col">What happens</th></tr></thead>
        <tbody>{copilotFusionPatterns.map(pattern => <tr><th scope="row">{pattern.name}</th><td>{pattern.behavior}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="resource-note copilot-after-table"><strong>Review the workspace.</strong> Discarded drafts can leave file edits behind. Inspect the diff before committing. Fusion does not start subagents itself, and its model pool and execution patterns can change. Hover over the effort label under a completed response to inspect the models used.</p>
    <p class="resource-source">Source: <a href={copilotSources.fusion.url}>current Fusion behavior and limitations</a>.</p>
  </section>

  <section class="resource-section" id="plans" aria-labelledby="plans-heading">
    <div class="resource-section-heading">
      <h2 id="plans-heading">Personal or business plan?</h2>
      <a href={copilotSources.plans.url}>GitHub plan documentation</a>
    </div>
    <p class="resource-summary">Personal allowances belong to the subscriber. Business and Enterprise seats contribute credits to a shared pool at the billing entity. Compare the monthly paid plans below.</p>
    <div class="resource-table-scroll" role="region" aria-labelledby="plan-caption" tabindex="0">
      <table class="resource-table plan-table">
        <caption id="plan-caption">Monthly paid plans, USD. Flex credits are variable; the totals reflect the review date.</caption>
        <thead><tr><th scope="col">Compare</th>{copilotPlans.map(plan => <th scope="col">{plan.name}<span class="cell-detail">{plan.audience}</span></th>)}</tr></thead>
        <tbody>
          {planRows.map(row => <tr class:list={{ 'plan-total': row.highlight }}><th scope="row">{row.label}</th>{row.values.map(value => <td class:list={{ 'plan-number': row.numeric }}>{value}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
    <div class="resource-plan-notes">
      <p><strong>Credits reset monthly.</strong> Included credits do not roll over. Personal flex allotments can change; they are separate from base credits. With additional usage disabled, organization usage stops after the pool is exhausted.</p>
      <p><strong>Free, Student, and annual subscriptions.</strong> Free and verified Student plans also exist, with automatic model selection; available Fusion efforts depend on the client and plan. Existing annual Pro and Pro+ subscriptions on legacy request billing have different rules; the table above covers monthly usage-based plans.</p>
      <p><strong>Training and retention are different.</strong> GitHub does not train on Business or Enterprise customer data. Personal subscribers have a training opt-out. Provider retention rules, including Fable exceptions, still need a separate check.</p>
    </div>
    <p class="resource-source">Details: <a href={copilotSources.individual.url}>personal credits and extra usage</a>, <a href={copilotSources.business.url}>shared pools and budgets</a>, and <a href={copilotSources.privacy.url}>model hosting and data use</a>.</p>
    <h3 class="copilot-subheading">Enterprise access announced at Universe</h3>
    <p class="resource-summary">Business and Enterprise subscriptions above remain available. The new access arrangements below have the feature/model eligibility of Copilot Enterprise, with usage charged from the first request.</p>
    <p class="resource-table-hint" id="access-hint">Scroll to compare seat charges and metered access.</p>
    <div class="resource-table-scroll" role="region" aria-labelledby="access-caption" aria-describedby="access-hint" tabindex="0">
      <table class="resource-table copilot-routing-table"><caption id="access-caption">Copilot access: seat charges do not include AI usage</caption>
        <thead><tr><th scope="col">Arrangement</th><th scope="col">Seat charge</th><th scope="col">Usage and rollout</th></tr></thead>
        <tbody>{copilotAccessPlans.map(plan => <tr><th scope="row">{plan.name}</th><td>{plan.seat}</td><td>{plan.usage}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="resource-source">Sources: <a href={copilotSources.enterpriseAccess.url}>enterprise rollout</a> and <a href={copilotSources.business.url}>billing and budget controls</a>. A zero seat charge does not include free metered usage. Set budgets before enabling access.</p>
  </section>

  <section class="resource-section" id="universe-updates" aria-labelledby="universe-heading">
    <div class="resource-section-heading"><h2 id="universe-heading">Universe updates and current workflows</h2><a href={copilotSources.universe.url}>GitHub Universe overview</a></div>
    <p class="resource-summary">Selected Copilot changes announced on 28 October, plus the 3 November Air integration. Release status, client support, policy, and billing vary by feature; follow the linked announcement before enabling it.</p>
    <p class="resource-table-hint" id="universe-hint">Scroll to compare capabilities and availability. Each row links to its official announcement.</p>
    <div class="resource-table-scroll" role="region" aria-labelledby="universe-caption" aria-describedby="universe-hint" tabindex="0">
      <table class="resource-table copilot-routing-table"><caption id="universe-caption">Copilot workflow changes reviewed 4 November 2026</caption>
        <thead><tr><th scope="col">Feature</th><th scope="col">What it adds</th><th scope="col">Availability and cost notes</th></tr></thead>
        <tbody>{copilotUniverseUpdates.map(update => <tr><th scope="row"><a href={update.url}>{update.name}</a></th><td>{update.detail}</td><td>{update.status}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="resource-section resource-sources" id="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Sources &amp; updates</h2>
    <p class="resource-source"><a href="/resources/github-copilot.json">Download the versioned JSON catalog</a> (schema 2). Billing reviewed on <time datetime={copilotBillingRules.reviewedAt}>{copilotReviewLabel}</time>; the Fusion promotion expires on <time datetime={copilotBillingRules.fusionDiscountUntil}>30 November 2026</time>.</p>
    <p class="resource-summary">This is a manually maintained reference, last reviewed on <time datetime={copilotReviewDate}>{copilotReviewLabel}</time>. GitHub can change rates, promotions, model availability, and allowances. Check the linked documentation before making a purchase or setting a budget.</p>
    <ul class="resource-source-list">{Object.values(copilotSources).map(source => <li><a href={source.url}>{source.title}</a></li>)}</ul>
    <a class="resource-back" href="/resources">Back to all resources</a>
  </section>
</ResourceLayout>
