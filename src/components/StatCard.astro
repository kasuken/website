---
interface Props {
	value: string | number;
	label: string;
	class?: string;
}

const { value, label, class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-1 p-6 bg-[var(--background-secondary)] border border-[var(--border)] rounded-[var(--radius-card)]", className]}>
	<span class="font-display text-3xl md:text-4xl font-semibold text-[var(--accent)] leading-none">{value}</span>
	<span class="mono-label mt-2">{label}</span>
</div>
