---
interface Props {
	href: string;
	index?: string;
	title: string;
	description?: string;
	cta?: string;
	class?: string;
}

const { href, index, title, description, cta, class: className } = Astro.props;
---

<a
	href={href}
	class:list={[
		"group flex flex-col gap-4 p-8 bg-[var(--background-secondary)] border border-[var(--border)] rounded-[var(--radius-card)] no-underline! hover:-translate-y-[3px] hover:shadow-md hover:border-[var(--accent)] transition-all duration-200",
		className,
	]}
>
	<div class="flex items-start justify-between gap-4">
		<span class="w-10 h-10 flex items-center justify-center rounded-[var(--radius-sm)] bg-[var(--accent)]/10 text-[var(--accent)]">
			<slot name="icon" />
		</span>
		{index && <span class="mono-label">{index}</span>}
	</div>
	<h3 class="font-display text-2xl text-[var(--text-primary)] mb-0! group-hover:text-[var(--accent)] transition-colors">{title}</h3>
	{description && <p class="text-[var(--text-secondary)] mb-0!">{description}</p>}
	{cta && (
		<span class="mt-auto pt-2 inline-flex items-center gap-2 text-sm font-semibold text-[var(--accent)]">
			{cta}
			<span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
		</span>
	)}
</a>
