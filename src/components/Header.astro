---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[var(--background)]/85 border-b border-[var(--border)]">
	<nav class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
		<div class="flex-shrink-0 flex items-center">
			<a href="/" class="font-display text-xl font-semibold tracking-tight text-[var(--text-primary)] no-underline! hover:text-[var(--accent)] transition-colors">
				{SITE_TITLE}
			</a>
		</div>
		
		<button class="md:hidden p-2 -mr-2 text-[var(--text-secondary)] hover:bg-[var(--background-secondary)] rounded-[var(--radius-sm)] transition-colors mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true">
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
		</button>
		
		<div class="hidden md:flex flex-1 items-center justify-center">
			<div class="flex items-center gap-1">
				<HeaderLink href="/blog">Writing</HeaderLink>
				<HeaderLink href="/portfolio">Work</HeaderLink>
				<HeaderLink href="/speaking">Speaking</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<div class="relative group">
					<button class="inline-flex items-center gap-1 px-4 py-2 rounded-[var(--radius-pill)] text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--background-secondary)] transition-colors" aria-haspopup="true" aria-expanded="false">
						More
						<svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3" aria-hidden="true"><path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06z"/></svg>
					</button>
					<div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-150">
						<div class="flex flex-col min-w-44 bg-[var(--background)] border border-[var(--border)] rounded-[var(--radius-card)] shadow-lg p-2">
							<a href="/activities" class="px-4 py-2 rounded-[var(--radius-sm)] text-sm font-medium text-[var(--text-secondary)] no-underline! hover:text-[var(--text-primary)] hover:bg-[var(--background-secondary)] transition-colors">Activities</a>
							<a href="/courses" class="px-4 py-2 rounded-[var(--radius-sm)] text-sm font-medium text-[var(--text-secondary)] no-underline! hover:text-[var(--text-primary)] hover:bg-[var(--background-secondary)] transition-colors">Courses</a>
							<a href="/live" class="px-4 py-2 rounded-[var(--radius-sm)] text-sm font-medium text-[var(--text-secondary)] no-underline! hover:text-[var(--text-primary)] hover:bg-[var(--background-secondary)] transition-colors">Live</a>
							<a href="/uses" class="px-4 py-2 rounded-[var(--radius-sm)] text-sm font-medium text-[var(--text-secondary)] no-underline! hover:text-[var(--text-primary)] hover:bg-[var(--background-secondary)] transition-colors">Uses</a>
							<a href="/newsletter" class="px-4 py-2 rounded-[var(--radius-sm)] text-sm font-medium text-[var(--text-secondary)] no-underline! hover:text-[var(--text-primary)] hover:bg-[var(--background-secondary)] transition-colors">Newsletter</a>
						</div>
					</div>
				</div>
			</div>
		</div>
		
		<div class="hidden md:flex flex-shrink-0 items-center gap-3">
			<a href="/mentor" class="inline-flex items-center px-5 py-2 rounded-[var(--radius-pill)] bg-[var(--accent)] text-[var(--background)]! text-sm font-semibold no-underline! hover:bg-[var(--accent-dark)] transition-colors">
				Book Mentoring
			</a>
			<ThemeToggle />
			<a href="https://github.com/kasuken" target="_blank" rel="noopener noreferrer" aria-label="My GitHub profile" class="w-9 h-9 flex items-center justify-center rounded-[var(--radius-pill)] text-[var(--text-secondary)] hover:bg-[var(--text-primary)] hover:text-[var(--background)] transition-colors">
				<svg viewBox="0 0 16 16" aria-hidden="true" class="w-5 h-5" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
			</a>
		</div>
	</nav>
	
	<!-- Mobile Menu -->
	<div class="mobile-menu hidden md:hidden border-t border-[var(--border)] bg-[var(--background)] px-4 py-4 space-y-2 flex flex-col items-center">
		<HeaderLink href="/" class="w-full text-center">Home</HeaderLink>
		<HeaderLink href="/blog" class="w-full text-center">Writing</HeaderLink>
		<HeaderLink href="/portfolio" class="w-full text-center">Work</HeaderLink>
		<HeaderLink href="/speaking" class="w-full text-center">Speaking</HeaderLink>
		<HeaderLink href="/about" class="w-full text-center">About</HeaderLink>
		<HeaderLink href="/activities" class="w-full text-center">Activities</HeaderLink>
		<HeaderLink href="/courses" class="w-full text-center">Courses</HeaderLink>
		<HeaderLink href="/live" class="w-full text-center">Live</HeaderLink>
		<HeaderLink href="/uses" class="w-full text-center">Uses</HeaderLink>
		<HeaderLink href="/newsletter" class="w-full text-center">Newsletter</HeaderLink>
		<a href="/mentor" class="w-full inline-flex items-center justify-center px-5 py-2.5 rounded-[var(--radius-pill)] bg-[var(--accent)] text-[var(--background)]! text-sm font-semibold no-underline! hover:bg-[var(--accent-dark)] transition-colors">
			Book Mentoring
		</a>
		<div class="pt-4 mt-2 w-full border-t border-[var(--border)] flex items-center justify-between px-3">
			<span class="text-sm font-medium text-[var(--text-secondary)]">Theme</span>
			<ThemeToggle />
		</div>
	</div>
</header>
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		const menuToggle = document.querySelector('.mobile-menu-toggle');
		const mobileMenu = document.querySelector('.mobile-menu');
		
		const toggleMenu = () => {
			if (!mobileMenu) return;

			const isHidden = mobileMenu.classList.toggle('hidden');
			menuToggle?.setAttribute('aria-expanded', String(!isHidden));
		};
		
		if (menuToggle) {
			menuToggle.addEventListener('click', toggleMenu);
			menuToggle.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					toggleMenu();
				}
			});
		}
	});
</script>
