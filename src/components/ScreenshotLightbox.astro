---
/**
 * Full-size preview for product screenshots. Any `.product-shot` button on
 * the page with `data-src` and `data-alt` opens it.
 */
---

<!-- Screenshot lightbox -->
<div id="shot-lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-label="Screenshot preview">
	<button id="shot-close" type="button" aria-label="Close preview" class="absolute top-5 right-5 w-11 h-11 flex items-center justify-center rounded-[var(--radius-pill)] bg-white/10 text-white hover:bg-white/20 transition-colors">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
	</button>
	<figure class="max-w-6xl max-h-full flex flex-col items-center gap-4 m-0">
		<img id="shot-img" src="" alt="" class="max-w-full max-h-[80vh] rounded-[var(--radius-card)] shadow-2xl object-contain" />
		<figcaption id="shot-caption" class="text-sm text-white/70 text-center max-w-2xl mb-0"></figcaption>
	</figure>
</div>

<script is:inline>
	document.addEventListener("DOMContentLoaded", function () {
		const box = document.getElementById("shot-lightbox");
		const img = document.getElementById("shot-img");
		const cap = document.getElementById("shot-caption");
		const closeBtn = document.getElementById("shot-close");
		if (!box || !img || !cap) return;
		const open = (src, alt) => {
			img.setAttribute("src", src);
			img.setAttribute("alt", alt);
			cap.textContent = alt;
			box.classList.remove("hidden");
			box.classList.add("flex");
			document.body.style.overflow = "hidden";
		};
		const close = () => {
			box.classList.add("hidden");
			box.classList.remove("flex");
			img.setAttribute("src", "");
			document.body.style.overflow = "";
		};
		document.querySelectorAll(".product-shot").forEach((el) => {
			el.addEventListener("click", () => open(el.getAttribute("data-src"), el.getAttribute("data-alt") || ""));
		});
		closeBtn && closeBtn.addEventListener("click", close);
		box.addEventListener("click", (e) => { if (e.target === box) close(); });
		document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !box.classList.contains("hidden")) close(); });
	});
</script>
