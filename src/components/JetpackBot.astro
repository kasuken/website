---
// Two pixel robots share a movement controller: one hops, one stays airborne.
// The sprite is authored as a character grid and rendered to crisp SVG rects
// at build time, so there are no image assets to load.

const PX = 3; // screen pixels per sprite pixel

const palette: Record<string, string> = {
	K: '#14161c', // outline
	W: '#e8eef4', // light plating
	G: '#a3b0bd', // mid plating
	D: '#5d6874', // dark plating
	A: 'var(--accent)', // visor + chest light, follows the theme
	R: '#e5484d', // jetpack tank
	r: '#a8262b', // jetpack shade
};

// Facing right; the jetpack sits on the back (left).
const body = [
	'.........K......',
	'........KAK.....',
	'.........K......',
	'......KKKKKKK...',
	'.....KWWWWWWWK..',
	'.....KWKKKKKKK..',
	'.....KWKAKKAKK..',
	'.....KWKKKKKKK..',
	'.....KGWWWWWWK..',
	'..KK..KKKKKKK...',
	'.KRRK.KWWWWWK...',
	'.KRrKKWWAAWWKK..',
	'.KRrKKWWWWWGKWK.',
	'.KDDK.KGGGGGKK..',
	'..KK..KDK.KDK...',
	'......KKK.KKK...',
];

const blink = [
	'.....KWKKKKKKK..',
	'.....KWKKKKKKK..',
];

const flameA = ['.YY.', '.OY.', '.OO.', '..O.', '..R.'];
const flameB = ['.YY.', 'YOOY', '.OO.', '.R..', '....'];
const flameColors: Record<string, string> = { Y: '#fff3a3', O: '#ff9a1f', R: '#e5484d' };

const toRects = (rows: string[], colors: Record<string, string>, ox = 0, oy = 0) =>
	rows.flatMap((row, y) =>
		[...row].flatMap((ch, x) =>
			colors[ch] ? [{ x: x + ox, y: y + oy, fill: colors[ch] }] : [],
		),
	);

const W = 16;
const H = 21;
const bodyRects = toRects(body, palette);
const blinkRects = toRects(blink, palette, 0, 5);
const flameARects = toRects(flameA, flameColors, 1, 15);
const flameBRects = toRects(flameB, flameColors, 1, 15);
const robots = [
	{ id: 'jetbot', kind: 'hopper', rects: bodyRects },
	{ id: 'jetbot-flyer', kind: 'flyer', rects: toRects(body, {
		...palette, A: '#a78bfa', R: '#528ce0', r: '#30599a',
	}) },
];
---

{robots.map((robot) => (
<div class="jetbot" id={robot.id} data-kind={robot.kind} data-state="idle" aria-hidden="true">
	<div class="jetbot__bubble" role="presentation"></div>
	<svg
		class="jetbot__sprite"
		width={W * PX}
		height={H * PX}
		viewBox={`0 0 ${W} ${H}`}
		shape-rendering="crispEdges"
	>
		<g class="jetbot__flame jetbot__flame--a">
			{flameARects.map((r) => <rect x={r.x} y={r.y} width="1" height="1" fill={r.fill} />)}
		</g>
		<g class="jetbot__flame jetbot__flame--b">
			{flameBRects.map((r) => <rect x={r.x} y={r.y} width="1" height="1" fill={r.fill} />)}
		</g>
		<g>
			{robot.rects.map((r) => <rect x={r.x} y={r.y} width="1" height="1" fill={r.fill} />)}
		</g>
		<g class="jetbot__gun">
			<rect x="12" y="11" width="6" height="3" fill={palette.K} />
			<rect x="13" y="11" width="4" height="1" fill={palette.G} />
			<rect x="16" y="12" width="2" height="1" fill={robot.kind === 'flyer' ? '#a78bfa' : palette.A} />
			<rect x="13" y="13" width="2" height="2" fill={palette.K} />
		</g>
		<g class="jetbot__blink">
			{blinkRects.map((r) => <rect x={r.x} y={r.y} width="1" height="1" fill={r.fill} />)}
		</g>
	</svg>
	<div class="jetbot__shadow"></div>
</div>
))}
<div class="jetbot-lasers" aria-hidden="true"></div>
<button class="jetbot-control" type="button" aria-pressed="false" hidden>Park robots</button>

<style>
	.jetbot {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 40; /* below the sticky header (z-50) so it ducks under it */
		width: 48px;
		height: 63px;
		cursor: pointer;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
		transform: translate3d(-200px, -200px, 0);
		transform-origin: 0 0;
		will-change: transform;
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.jetbot[data-ready] { opacity: 1; }
	.jetbot[data-parked] { opacity: 0; pointer-events: none; }

	.jetbot__sprite {
		display: block;
		overflow: visible;
		image-rendering: pixelated;
		transform-origin: 50% 70%;
		filter: drop-shadow(0 2px 0 rgb(0 0 0 / 0.18));
	}

	/* Jetpack flame: two frames, stepped like an old console sprite. */
	.jetbot__flame { display: none; }
	.jetbot:is([data-state='flying'], [data-state='hovering']) .jetbot__flame--a { display: block; animation: jetbot-flicker 0.16s steps(1) infinite; }
	.jetbot:is([data-state='flying'], [data-state='hovering']) .jetbot__flame--b { display: block; animation: jetbot-flicker 0.16s steps(1) infinite reverse; }
	@keyframes jetbot-flicker {
		0% { opacity: 1; }
		50% { opacity: 0; }
	}

	/* Idle: a 2-frame bob and an occasional blink. */
	.jetbot[data-state='idle'] .jetbot__sprite { animation: jetbot-bob 0.9s steps(2) infinite; }
	@keyframes jetbot-bob {
		0% { translate: 0 0; }
		100% { translate: 0 -3px; }
	}
	.jetbot__blink { opacity: 0; }
	.jetbot[data-state='idle'] .jetbot__blink { animation: jetbot-blink 3.4s steps(1) infinite; }
	@keyframes jetbot-blink {
		0%, 94% { opacity: 0; }
		95%, 100% { opacity: 1; }
	}

	.jetbot__shadow {
		position: absolute;
		left: 50%;
		top: 48px; /* sprite feet; the flame hangs below */
		width: 24px;
		height: 3px;
		margin-left: -12px;
		background: rgb(0 0 0 / 0.18);
		opacity: 0;
		transition: opacity 0.2s;
	}
	.jetbot[data-state='idle'] .jetbot__shadow { opacity: 1; }

	.jetbot__bubble {
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		translate: -50% 4px;
		padding: 4px 8px;
		white-space: nowrap;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 11px;
		line-height: 1.3;
		color: var(--text-primary);
		background: var(--background);
		border: 2px solid var(--text-primary);
		box-shadow: 3px 3px 0 var(--accent);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s steps(2), translate 0.15s steps(2);
	}
	.jetbot__bubble[data-show] { opacity: 1; translate: -50% 0; }

	.jetbot-lasers {
		position: fixed;
		inset: 0;
		z-index: 39;
		pointer-events: none;
		overflow: hidden;
	}
	.jetbot-lasers :global(.jetbot-laser) {
		position: absolute;
		top: 0;
		left: 0;
		width: 22px;
		height: 3px;
		transform-origin: 0 50%;
		background: var(--laser-color);
		border-radius: 2px;
	}
	.jetbot-control {
		position: fixed;
		bottom: 12px;
		right: 12px;
		z-index: 40;
		padding: 8px 12px;
		min-height: 44px;
		font: inherit;
		font-size: 12px;
		color: var(--text-primary);
		background: var(--background);
		border: 1px solid var(--border);
		border-radius: 6px;
		cursor: pointer;
	}
	.jetbot-control:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
	.jetbot[data-paused] *, .jetbot[data-parked] * { animation-play-state: paused !important; }
	.jetbot[data-paused] { opacity: 0; pointer-events: none; }
	@media (hover: hover) {
		.jetbot-control:hover { border-color: var(--accent); }
	}

	@media (prefers-reduced-motion: reduce) {
		.jetbot, .jetbot-lasers, .jetbot-control { display: none; }
	}

	@media print {
		.jetbot, .jetbot-lasers, .jetbot-control { display: none; }
	}
</style>

<script>
	import '../scripts/jetpack-bots';
</script>
